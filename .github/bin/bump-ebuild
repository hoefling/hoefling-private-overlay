#!/usr/bin/env python3
"""
Create ebuilds for the versions listed in .github/.renovate/packages.yml.

For every package whose ebuild for the listed version is missing, the newest
existing release ebuild is copied, old ebuilds beyond KEEP_OLD are dropped and
the Manifest is regenerated. Stale md5-cache entries are removed as well.

The script is idempotent and only looks at the working tree, so it can be run
locally and in CI alike. Pass --commit to create one commit per package.
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from functools import cmp_to_key
from pathlib import Path
from typing import Any

import yaml
from portage.versions import vercmp


ROOT = Path(__file__).resolve().parent.parent.parent
PACKAGES_FILE = ROOT / ".github" / ".renovate" / "packages.yml"
MD5_CACHE = ROOT / "metadata" / "md5-cache"

# number of older versions to keep next to the newly added one for rollbacks
KEEP_OLD = 2


def load_packages(path: Path) -> list[dict[str, Any]]:
    with path.open() as f:
        return yaml.safe_load(f)["packages"]


def run(*cmd: str) -> None:
    subprocess.run(cmd, cwd=ROOT, check=True)


def release_versions(package_dir: Path) -> list[str]:
    """Versions of release (non-live) ebuilds, newest first."""
    name = package_dir.name
    pattern = re.compile(rf"^{re.escape(name)}-(\d.*)\.ebuild$")
    versions = [
        m.group(1)
        for p in package_dir.iterdir()
        if (m := pattern.match(p.name)) and m.group(1) != "9999"
    ]
    return sorted(versions, key=cmp_to_key(vercmp), reverse=True)


def bump(package: dict[str, Any], commit: bool) -> None:
    atom, version = package["atom"], str(package["version"])
    category, name = atom.split("/", 1)
    package_dir = ROOT / category / name

    if not package_dir.is_dir():
        raise RuntimeError(f"Package directory does not exist: {package_dir}")

    new_ebuild = package_dir / f"{name}-{version}.ebuild"
    if new_ebuild.exists():
        return

    versions = release_versions(package_dir)
    if not versions:
        raise RuntimeError(f"{atom}: no existing release ebuild to copy from")

    template = package_dir / f"{name}-{versions[0]}.ebuild"
    print(f"{atom}: {versions[0]} -> {version}")
    new_ebuild.write_bytes(template.read_bytes())

    # keep the new version plus KEEP_OLD older ones
    for old in release_versions(package_dir)[KEEP_OLD + 1 :]:
        print(f"{atom}: dropping {old}")
        (package_dir / f"{name}-{old}.ebuild").unlink()

    try:
        run("pkgdev", "manifest", str(package_dir))
    except subprocess.CalledProcessError:
        new_ebuild.unlink()
        raise RuntimeError(
            f"{atom}: 'pkgdev manifest' failed for {version}. The distfiles, "
            "most likely the <pkg>-ebuild-deps release, may not exist yet. "
            "Re-run this job once the deps release has been published."
        ) from None

    if commit:
        run("git", "add", "--all", str(package_dir))
        run("git", "commit", "--quiet", "-m", f"{atom}: add {version}")


def prune_md5_cache() -> list[Path]:
    """Remove cache entries that have no matching ebuild anymore."""
    removed = []
    for entry in sorted(MD5_CACHE.glob("*/*")):
        category = entry.parent.name
        # strip the version to find the package directory: <name>-<version>
        m = re.match(r"^(?P<name>.+?)-(?P<ver>\d[^/]*)$", entry.name)
        if m and (ROOT / category / m["name"] / f"{entry.name}.ebuild").is_file():
            continue
        entry.unlink()
        removed.append(entry)
    return removed


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--commit", action="store_true", help="commit each package bump"
    )
    args = parser.parse_args()

    failures = []
    for package in load_packages(PACKAGES_FILE):
        try:
            bump(package, args.commit)
        except RuntimeError as e:
            print(f"::error::{e}", file=sys.stderr)
            failures.append(package["atom"])

    for entry in prune_md5_cache():
        print(f"removed stale cache entry {entry.relative_to(ROOT)}")

    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
